# Razorpay (weekend deals checkout). When both keys are set, checkout uses Razorpay; otherwise it falls back to Dodo below.
# API key ID (rzp_test_... or rzp_live_...): Razorpay dashboard → Account & Settings → API keys
RAZORPAY_KEY_ID=
# API key secret, shown once when the key is generated
RAZORPAY_KEY_SECRET=
# Secret set on the webhook that points at /api/webhook/razorpay (Account & Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Dodo Payments (fallback checkout, used only when the Razorpay keys are not set). Keys: Dodo dashboard → Developer.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode or live_mode (anything else falls back to test_mode)
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Dodo product IDs (pdt_...) for each weekend deal, see lib/payments/deals.ts
DODO_PRODUCT_REEL_30S=
DODO_PRODUCT_REEL_60S=
# Public site origin used for the post-payment return URL
NEXT_PUBLIC_SITE_URL=https://bconclub.com
